# ClickHouse Tools Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Default project and environment
# Used when no project/environment is specified in commands
CH_DEFAULT_PROJECT=metopio
CH_DEFAULT_ENV=dev

# Credentials for each project/environment
# Format: CH_{PROJECT}_{ENV}_USER and CH_{PROJECT}_{ENV}_PASSWORD

# Metopio Development
CH_METOPIO_DEV_USER=dans_service_user
CH_METOPIO_DEV_PASSWORD=your_dev_password_here

# Metopio Staging
CH_METOPIO_STAGING_USER=dans_service_user
CH_METOPIO_STAGING_PASSWORD=your_staging_password_here

# Metopio Production
CH_METOPIO_PROD_USER=dans_service_user
CH_METOPIO_PROD_PASSWORD=your_prod_password_here

# Example for another project
# CH_ANALYTICS_DEV_USER=service_user
# CH_ANALYTICS_DEV_PASSWORD=password
# CH_ANALYTICS_PROD_USER=service_user
# CH_ANALYTICS_PROD_PASSWORD=password

# Optional: ClickHouse client path (if not in PATH)
# CH_CLIENT_PATH=/usr/local/bin/clickhouse-client

# Optional: Editor for config editing
# EDITOR=code

# Optional: Credential storage method (env, keyring, prompt)
# CH_CREDENTIAL_STORAGE=env